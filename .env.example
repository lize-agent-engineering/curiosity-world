# Curiosity World server configuration
# Keep secrets only in .env.local; never expose them in browser code.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback model for any role without its own route. This exact name is what
# lib/server/resolve-model.ts reads — CURIOSITY_DEFAULT_MODEL is accepted only by
# the deploy readiness check, so setting that alone leaves the app unable to
# resolve a model. Missing configuration fails the request explicitly.
DEFAULT_MODEL=openrouter:z-ai/glm-5.2

# Per-role model routing. A configured route wins over DEFAULT_MODEL and over a
# client-sent x-model. Unlisted roles silently fall back to DEFAULT_MODEL, and an
# unknown role name is ignored with a warning, so keep this list aligned with
# the roles in lib/curiosity/agent-contracts.ts.
MODEL_ROUTES={"curiosity.question-modeler":"openrouter:z-ai/glm-5.2","curiosity.knowledge-designer":"openrouter:z-ai/glm-5.2","curiosity.interaction-designer":"openrouter:z-ai/glm-5.2","curiosity.presentation-designer":"openrouter:z-ai/glm-5.2","curiosity.quality-reviewer":"openrouter:z-ai/glm-5.2","curiosity.revision-planner":"openrouter:z-ai/glm-5.2"}

# Per-call model timeout, 10000-300000 ms (default 120000). Generation runs five
# sequential stages in the worker, bounded overall by the 10-minute budget.
CURIOSITY_MODEL_TIMEOUT_MS=300000

# Fixed Chinese narration and transcription for the child experience.
CURIOSITY_TTS_PROVIDER=openrouter-tts
CURIOSITY_TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
CURIOSITY_TTS_VOICE=longanxiaoxin
CURIOSITY_TTS_SPEED=0.92
CURIOSITY_ASR_PROVIDER=openrouter-asr
CURIOSITY_ASR_MODEL=qwen/qwen3-asr-1.7b
CURIOSITY_ASR_LANGUAGE=zh

# Public mode: expose only the Curiosity homepage, experience pages, health
# endpoint and Curiosity APIs. Required for the shared deployment.
CURIOSITY_PUBLIC_MODE=1

# Optional shared-deployment access gate.
# ACCESS_CODE=

# Optional embedding allow-list, set at build time for Docker deployment.
# ALLOWED_FRAME_ANCESTORS=
